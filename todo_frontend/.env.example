# Optional REST API base URL (e.g., https://api.example.com)
REACT_APP_API_BASE=

# Alternative backend base URL (fallback if API_BASE not set)
REACT_APP_BACKEND_URL=

# Optional WebSocket URL; origin used to infer HTTP base if others unset (e.g., wss://example.com/ws)
REACT_APP_WS_URL=

# Display-only environment name
REACT_APP_NODE_ENV=development

# Template-provided optional vars (not required for this app but supported)
REACT_APP_FRONTEND_URL=
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
